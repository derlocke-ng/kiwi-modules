[Unit]
Description=Nextcloud on {{ hostname }}: sign-in with the network's accounts
Documentation=https://github.com/derlocke-ng/kiwi-server
After=kiwi-stack.service
Wants=kiwi-stack.service

[Service]
Type=oneshot
RemainAfterExit=yes
# the client's secret: in this unit's environment, not on a command line of the host
EnvironmentFile={{ docker_dir }}/kiwi/cloud-accounts.env
ExecStart=/usr/bin/bash {{ docker_dir }}/kiwi/cloud-accounts.sh
TimeoutStartSec=45min

[Install]
WantedBy=multi-user.target
