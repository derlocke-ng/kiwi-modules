#!/usr/bin/bash
# {{ hostname }}'s Nextcloud signs people in with the network's accounts (the accounts module,
# kiwi-server accounts <fleet> connect <host> cloud): Nextcloud's own OpenID Connect app, with the
# accounts as its provider "accounts". A person's first sign-in makes their Nextcloud user.
# kn-cloud-accounts.service runs this after every start of the stack.
set -euo pipefail

WWW_DATA=33
occ() { {{ runtime }} exec --user "$WWW_DATA" nextcloud-aio-nextcloud php /var/www/html/occ "$@"; }

for _ in {1..360}; do
    status=$(occ status --output=json 2>/dev/null || true)
    [[ $status == *'"installed":true'*'"maintenance":false'*'"needsDbUpgrade":false'* ]] && break
    sleep 5
done

occ app:list --output=json 2>/dev/null | grep -q '"user_oidc"' || occ app:install user_oidc >/dev/null
occ app:enable user_oidc >/dev/null
# the admin and people made in Nextcloud itself still sign in with their own passwords
occ config:app:set --value=1 user_oidc allow_multiple_user_backends >/dev/null
occ user_oidc:provider accounts --clientid={{ accounts_client }} --clientsecret="$KIWI_SECRET" \
    --discoveryuri={{ accounts_issuer }}/.well-known/openid-configuration --scope="openid email profile" \
    --mapping-uid=preferred_username --mapping-display-name=name --mapping-email=email --unique-uid=0 >/dev/null
echo "kiwi: Nextcloud signs people in with the network's accounts"
