# control
services:
  {{ container_prefix }}-control:
    image: {{ image }}
    container_name: {{ container_prefix }}-control
    command: ["serve", "/fleet/fleet.yaml", "--listen", "0.0.0.0:8740", "--status-minutes", "{{ status_minutes }}"]
    environment:
      # an apply of this machine restarts this container: the role then runs detached from it
      - KIWI_CONTROL_HOST={{ hostname.split('.')[0] }}
    volumes:
      - {{ docker_dir }}/{{ container_prefix }}-control:/fleet:Z
    restart: unless-stopped
    networks:
      {{ network_name }}:
        ipv4_address: {{ container_ip }}
    logging:
      driver: json-file
      options:
        max-size: 10m
