# strfry 1.1.3 with auth.patch, and Python for the nostr-relay module's write policy.
# Built from a pinned commit; drop this image when strfry itself passes the key on.
FROM docker.io/library/alpine:3.24 AS build
RUN apk --no-cache add linux-headers git g++ make perl pkgconfig libtool ca-certificates \
    libressl-dev zlib-dev lmdb-dev flatbuffers-dev libsecp256k1-dev zstd-dev
WORKDIR /build
RUN git clone --branch 1.1.3 --depth 1 https://github.com/hoytech/strfry . && \
    test "$(git rev-parse HEAD)" = 16c00df04e264f4d68db5e10a48127f015c7824b && \
    git submodule update --init
COPY auth.patch /tmp/auth.patch
RUN git apply /tmp/auth.patch && make setup-golpe && make -j"$(nproc)"

FROM docker.io/library/alpine:3.24
RUN apk --no-cache add lmdb libsecp256k1 zstd-libs zlib libstdc++ libressl4.3-libssl libressl4.3-libcrypto python3
LABEL org.opencontainers.image.source=https://github.com/derlocke-ng/kiwi-modules
WORKDIR /app
COPY --from=build /build/strfry strfry
EXPOSE 7777
ENTRYPOINT ["/app/strfry"]
CMD ["relay"]
